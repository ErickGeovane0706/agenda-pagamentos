# Copie para .env e preencha. Nenhum valor real vive neste arquivo.
#
# ATENCAO: toda VITE_* e lida na COMPILACAO, nao em tempo de execucao — o
# Vite troca import.meta.env.VITE_X pelo literal dentro do bundle. Definir a
# variavel no painel da hospedagem NAO basta: ela precisa chegar ao
# `npm run build`, via os ARG/ENV do Dockerfile.

VITE_API_URL=http://localhost:8080

# Numero COMPLETO, com DDI, so digitos: 55 + DDD + numero.
#   certo : 5583999999999
#   ERRADO: 83999999999    <- sem o 55. Monta um link que abre e nao chega
#                             em ninguem; o codigo recusa e esconde o convite.
# Vazio tambem esconde o convite ao WhatsApp na landing.
VITE_WHATSAPP_SUPORTE=

# Anti-bot do cadastro. Vazio = o formulario usa o escape hatch.
VITE_TURNSTILE_SITE_KEY=

# Observabilidade. Vazio = o Sentry nao inicia.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=local

# Pixel de conversao. Vazio = nao carrega.
VITE_META_PIXEL_ID=
