# Copie para .env e preencha. Nenhum valor real vive neste arquivo.
# Em producao, estas variaveis sao definidas no painel do Railway.

# ─── Banco ─────────────────────────────────────────────────────────────
# O docker-compose local ja sobe um Postgres 18 com estes valores.
DATABASE_URL=jdbc:postgresql://localhost:5432/agenda_pagamentos
DATABASE_USER=postgres
DATABASE_PASS=postgres
DB_POOL_SIZE=5

# ─── Aplicacao ─────────────────────────────────────────────────────────
PORT=8080
SPRING_PROFILES_ACTIVE=local
# Precisa ser o mesmo dominio cadastrado no gateway: ele recusa uma
# successUrl de outro dominio com 400.
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Autenticacao ──────────────────────────────────────────────────────
# Qualquer string longa serve em desenvolvimento. Em producao, gere uma
# aleatoria e nunca a reaproveite entre ambientes.
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
SENHA_RESET_TTL_HORAS=2
REGISTRO_TTL_HORAS=48

# ─── Gateway de pagamento (Asaas) ──────────────────────────────────────
# Sandbox por padrao. O perfil `prod` aponta para producao sozinho.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Sem este token o webhook FALHA FECHADA e recusa tudo — e proposital.
ASAAS_WEBHOOK_TOKEN=

# ─── Assinatura ────────────────────────────────────────────────────────
ASSINATURA_PRECO_BASE=48.60
ASSINATURA_PRECO_LOJA_ADICIONAL=17.84
ASSINATURA_TRIAL_DIAS=30
ASSINATURA_CARENCIA_DIAS=5

# ─── Armazenamento de arquivos (Cloudflare R2, API do S3) ──────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=agenda-pagamentos-arquivos

# ─── WhatsApp (Meta Cloud API) ─────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ─── IA do agente ──────────────────────────────────────────────────────
# Classificacao de intencao e transcricao de audio. Vazias = o agente
# responde sem entender intencao; o resto do sistema segue normal.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# ─── E-mail transacional (Resend) ──────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Dia de Pagar <onboarding@resend.dev>

# ─── Anti-bot no cadastro (Cloudflare Turnstile) ───────────────────────
TURNSTILE_SECRET=

# ─── Limites de uso por plano ──────────────────────────────────────────
USO_TRIAL_AGENTE=400
USO_TRIAL_AUDIOS=60
USO_TRIAL_TEMPLATES=300
USO_ATIVA_AGENTE=2000
USO_ATIVA_AUDIOS=300
USO_ATIVA_TEMPLATES=1500

# ─── Observabilidade ───────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
